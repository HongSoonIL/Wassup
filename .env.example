# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 커밋하지 않는다.
# SECRET_KEY 만들기:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL — docker-compose.yml과 Django가 같은 값을 읽는다
POSTGRES_DB=wassup
POSTGRES_USER=wassup
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# 발행 사진 폴더. 프로젝트 기준 상대 경로 또는 절대 경로를 넣는다.
# POST_PHOTO_DIR=private-media

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# LLM — fake면 API 호출 없이 정해 둔 말풍선을 돌려준다 (설계서 2.2절)
# 실제 대화 답장은 openai로 설정하고 Responses API 구조화 출력을 지원하는 모델 ID를 넣는다.
LLM_BACKEND=fake
LLM_MODEL=
LLM_API_KEY=

# 세계 시계 배속 — 60이면 실제 1분이 세계 1시간 (시연용)
WORLD_CLOCK_SPEED=1
