# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 커밋하지 않는다.
# SECRET_KEY 만들기:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL — docker-compose.yml과 Django가 같은 값을 읽는다
POSTGRES_DB=wassup
POSTGRES_USER=wassup
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# 발행 사진 폴더. 프로젝트 기준 상대 경로 또는 절대 경로를 넣는다.
# POST_PHOTO_DIR=private-media

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# fake는 답장, 주간 후보, 동의한 방의 기억 추출을 키 없이 실행한다.
# 실제 생성은 openai로 설정하고 Responses API 구조화 출력을 지원하는 모델 ID를 넣는다.
LLM_BACKEND=fake
LLM_MODEL=
LLM_API_KEY=

# 용도별 모델을 생략하면 LLM_MODEL을 쓴다. 추론 강도를 비우면 모델 기본값을 쓴다.
LLM_CHAT_MODEL=gpt-6.2-sol
LLM_CHAT_EFFORT=low
LLM_MEMORY_MODEL=gpt-6-luna
LLM_MEMORY_EFFORT=low
LLM_WEEKLY_MODEL=
LLM_WEEKLY_EFFORT=

# 세계 시계 배속 — 60이면 실제 1분이 세계 1시간 (시연용)
WORLD_CLOCK_SPEED=1
